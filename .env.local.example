# Public base URL of the Express backend API (include /api/v1).
# The browser calls this directly, so it must be reachable from the client.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Optional: used by server components in the Next.js process. Useful when the
# browser URL differs from the internal container URL (for example Docker).
# Falls back to NEXT_PUBLIC_API_BASE_URL when empty.
API_INTERNAL_URL=

# Optional: Google Identity Services client ID. When set, the Google login
# button is enabled on the login page. The backend verifies the ID token.
# Leave empty to hide Google login.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
